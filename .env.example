# Public site URL (used for canonical URLs, sitemap, and OG tags)
NUXT_PUBLIC_SITE_URL=https://www.digsolutions.net

# Google Tag Manager container ID (leave blank to disable)
NUXT_PUBLIC_GTM_ID=

# Google Analytics 4 Measurement ID (leave blank to disable)
NUXT_PUBLIC_GA_ID=

# Resend (https://resend.com) API key for the contact form.
# Without this set, submissions are logged server-side instead of emailed.
RESEND_API_KEY=

# Where contact form submissions should be delivered
CONTACT_TO_EMAIL=hello@digsolutions.net

# Must be a verified sender/domain in your Resend account
CONTACT_FROM_EMAIL=DigSolutions Website <onboarding@resend.dev>
